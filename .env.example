# Bot Configuration
BOT_TOKEN=your_bot_token_here_from_BotFather
BOT_NAME=Simple Telegram Bot
BOT_VERSION=1.0.0

# Author Info
AUTHOR_NAME=Your Name
AUTHOR_EMAIL=your@email.com

# Admin IDs (comma-separated, bisa banyak)
# Dapatkan user ID dari @userinfobot di Telegram
ADMIN_IDS=123456789,987654321

# Optional: API Keys for modules
# WEATHER_API_KEY=your_weather_api_key