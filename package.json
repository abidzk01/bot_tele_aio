{
  "name": "bot-telegram-aio",
  "version": "1.0.0",
  "description": "Telegram Bot AIO - All-in-One modular bot with music downloader, system monitoring, and extensible module system",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "db:init": "node scripts/init-db.js",
    "db:reset": "node scripts/reset-db.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "playwright": "^1.64.1",
    "sql.js": "^1.12.0",
    "telegraf": "^4.16.3",
    "verdana": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^8.57.0",
    "globals": "^15.0.0",
    "jest": "^29.7.0"
  },
  "keywords": [
    "telegram",
    "bot",
    "music",
    "downloader",
    "aio",
    "modular"
  ],
  "license": "MIT",
  "author": "abidzk01",
  "repository": {
    "type": "git",
    "url": "https://github.com/abidzk01/bot_tele_aio.git"
  },
  "bugs": {
    "url": "https://github.com/abidzk01/bot_tele_aio/issues"
  },
  "homepage": "https://github.com/abidzk01/bot_tele_aio#readme",
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleFileExtensions": [
      "js",
      "mjs"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "modules/**/*.js",
      "index.js",
      "!**/node_modules/**"
    ]
  }
}
